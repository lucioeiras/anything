{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "release": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "e2e": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_E2E": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    }
  }
}
